<datasource-dependencies datasource='federated.kg2i9plxjt8dcc9220eygdcli7u0'>
<column caption='Score Band' datatype='string' name='[score_band]' role='dimension' type='nominal' />
<column caption='Cards' datatype='integer' default-format='n#,##0' name='[cards]' role='measure' type='quantitative' />
<column caption='Bad 6m Rate' datatype='real' default-format='p0.0%' name='[bad_6m_rate]' role='measure' type='quantitative' />
<column caption='Channel Group' datatype='string' name='[channel_group]' role='dimension' type='nominal' />
<column caption='Keep' datatype='boolean' name='[Keep]' role='dimension' type='nominal'>
  <calculation class='tableau' formula='([Parameters].[Bureau score band] = &quot;(All)&quot; OR [score_band] = [Parameters].[Bureau score band])' />
</column>
<column caption='Bad cards' datatype='real' name='[Bad cards]' role='measure' type='quantitative'>
  <calculation class='tableau' formula='[cards] * [bad_6m_rate]' />
</column>
<column caption='Ratio by band' datatype='real' default-format='n#,##0.0' name='[Ratio by band]' role='measure' type='quantitative'>
  <calculation class='tableau' formula='{FIXED [score_band] :&#10;    (SUM(IF [channel_group] = &quot;Fintech Co-brand&quot; THEN [Bad cards] END) / SUM(IF [channel_group] = &quot;Fintech Co-brand&quot; THEN [cards] END))&#10;  / (SUM(IF [channel_group] = &quot;Other channels&quot; THEN [Bad cards] END) / SUM(IF [channel_group] = &quot;Other channels&quot; THEN [cards] END))}' />
</column>
<column caption='Lowest ratio' datatype='real' default-format='n#,##0.0' name='[Lowest ratio]' role='measure' type='quantitative'>
  <calculation class='tableau' formula='MIN([Ratio by band])' />
</column>
<column caption='Highest ratio' datatype='real' default-format='n#,##0.0' name='[Highest ratio]' role='measure' type='quantitative'>
  <calculation class='tableau' formula='MAX([Ratio by band])' />
</column>
<column caption='Other rate in band' datatype='real' name='[Other rate in band]' role='measure' type='quantitative'>
  <calculation class='tableau' formula='{FIXED [score_band] : SUM(IF [channel_group] = &quot;Other channels&quot; THEN [Bad cards] END)&#10;                       / SUM(IF [channel_group] = &quot;Other channels&quot; THEN [cards] END)}' />
</column>
<column caption='Co-brand bad' datatype='real' default-format='p0.0%' name='[Co-brand bad]' role='measure' type='quantitative'>
  <calculation class='tableau' formula='SUM(IF [channel_group] = &quot;Fintech Co-brand&quot; THEN [Bad cards] END) / SUM(IF [channel_group] = &quot;Fintech Co-brand&quot; THEN [cards] END)' />
</column>
<column caption='Other bad' datatype='real' default-format='p0.0%' name='[Other bad]' role='measure' type='quantitative'>
  <calculation class='tableau' formula='SUM(IF [channel_group] = &quot;Other channels&quot; THEN [Bad cards] END) / SUM(IF [channel_group] = &quot;Other channels&quot; THEN [cards] END)' />
</column>
<column caption='Co-brand expected' datatype='real' default-format='p0.0%' name='[Co-brand expected]' role='measure' type='quantitative'>
  <calculation class='tableau' formula='SUM(IF [channel_group] = &quot;Fintech Co-brand&quot; THEN [cards] * [Other rate in band] END)&#10;/ SUM(IF [channel_group] = &quot;Fintech Co-brand&quot; THEN [cards] END)' />
</column>
<column caption='Gap left' datatype='real' default-format='p0%' name='[Gap left]' role='measure' type='quantitative'>
  <calculation class='tableau' formula='([Co-brand bad] - [Co-brand expected]) / ([Co-brand bad] - [Other bad])' />
</column>
<column caption='Gap rest' datatype='real' default-format='p0%' name='[Gap rest]' role='measure' type='quantitative'>
  <calculation class='tableau' formula='1 - [Gap left]' />
</column>
<column caption='One' datatype='real' name='[One]' role='measure' type='quantitative'>
  <calculation class='tableau' formula='MIN(1)' />
</column>
<column caption='Zero' datatype='real' name='[Zero]' role='measure' type='quantitative'>
  <calculation class='tableau' formula='MIN(0)' />
</column>
<column caption='Zero 2' datatype='real' name='[Zero 2]' role='measure' type='quantitative'>
  <calculation class='tableau' formula='MIN(0)' />
</column>
<column caption='Same score chg' datatype='real' name='[Same score chg]' role='measure' type='quantitative'>
  <calculation class='tableau' formula='[Lowest ratio] - 1' />
</column>
<column caption='Same score dir' datatype='string' name='[Same score dir]' role='dimension' type='nominal'>
  <calculation class='tableau' formula='IF [Same score chg] &gt; 0 THEN &quot;worse&quot; ELSEIF [Same score chg] &lt; 0 THEN &quot;better&quot; ELSE &quot;neutral&quot; END' />
</column>
<column caption='Same score up' datatype='string' name='[Same score up]' role='dimension' type='nominal'>
  <calculation class='tableau' formula='IF [Same score chg] &gt; 0 THEN &quot;▲ &quot; END' />
</column>
<column caption='Same score down' datatype='string' name='[Same score down]' role='dimension' type='nominal'>
  <calculation class='tableau' formula='IF [Same score chg] &lt; 0 THEN &quot;▼ &quot; END' />
</column>
<column caption='Same score same' datatype='string' name='[Same score same]' role='dimension' type='nominal'>
  <calculation class='tableau' formula='IF [Same score chg] = 0 THEN &quot;no change&quot; END' />
</column>
<column caption='Same score worse n' datatype='real' default-format='n&quot;from &quot;0.0&quot;×&quot;' name='[Same score worse n]' role='measure' type='quantitative'>
  <calculation class='tableau' formula='IF [Same score chg] &gt; 0 THEN ABS([Lowest ratio]) END' />
</column>
<column caption='Same score better n' datatype='real' default-format='n&quot;from &quot;0.0&quot;×&quot;' name='[Same score better n]' role='measure' type='quantitative'>
  <calculation class='tableau' formula='IF [Same score chg] &lt; 0 THEN ABS([Lowest ratio]) END' />
</column>
<column caption='Main cause' datatype='string' name='[Main cause]' role='dimension' type='nominal'>
  <calculation class='tableau' formula='IF [Gap left] &gt;= 0.5 THEN &quot;Channel&quot; ELSE &quot;Customer mix&quot; END' />
</column>
<column caption='Gap left (ring)' datatype='real' default-format='p0%' name='[Gap left (ring)]' role='measure' type='quantitative'>
  <calculation class='tableau' formula='[Gap left]' />
</column>
<column-instance column='[Keep]' derivation='None' name='[none:Keep:nk]' pivot='key' type='nominal' />
<column-instance column='[One]' derivation='User' name='[usr:One:qk]' pivot='key' type='quantitative' />
<column-instance column='[Same score better n]' derivation='User' name='[usr:Same score better n:qk]' pivot='key' type='quantitative' />
<column-instance column='[Same score dir]' derivation='User' name='[usr:Same score dir:nk]' pivot='key' type='nominal' />
<column-instance column='[Same score down]' derivation='User' name='[usr:Same score down:nk]' pivot='key' type='nominal' />
<column-instance column='[Same score same]' derivation='User' name='[usr:Same score same:nk]' pivot='key' type='nominal' />
<column-instance column='[Same score up]' derivation='User' name='[usr:Same score up:nk]' pivot='key' type='nominal' />
<column-instance column='[Same score worse n]' derivation='User' name='[usr:Same score worse n:qk]' pivot='key' type='quantitative' />
</datasource-dependencies>
