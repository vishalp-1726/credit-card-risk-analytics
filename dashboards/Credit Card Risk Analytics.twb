<worksheet name='T3 Value range'>
<layout-options>
<title>
<formatted-text>
<run bold='true' fontcolor='#515151' fontname='Tableau Semibold' fontsize='10'>Extra loss avoided per month: low / central / high (Rs lakh)</run>
</formatted-text>
</title>
<caption>
<formatted-text>
<run>analysis as of Aug-2026</run>
</formatted-text>
</caption>
</layout-options>
<table>
<view>
<datasources>
<datasource caption='value_range' name='federated.1oaahrx0bds75i12qhgvf0w5n7sr' />
</datasources>
<datasource-dependencies datasource='federated.1oaahrx0bds75i12qhgvf0w5n7sr'>
<column caption='Case' datatype='string' name='[case]' role='dimension' type='nominal' />
<column caption='Extra Loss Avoided Per Month' datatype='real' name='[extra_loss_avoided_per_month]' role='measure' type='quantitative' />
<column caption='Range lakh' datatype='real' default-format='n#,##0.0' name='[Range lakh]' role='measure' type='quantitative'>
  <calculation class='tableau' formula='SUM([extra_loss_avoided_per_month]) / 100000' />
</column>
<column-instance column='[case]' derivation='None' name='[none:case:nk]' pivot='key' type='nominal' />
<column-instance column='[Range lakh]' derivation='User' name='[usr:Range lakh:qk]' pivot='key' type='quantitative' />
</datasource-dependencies>

<sort class='manual' column='[federated.1oaahrx0bds75i12qhgvf0w5n7sr].[none:case:nk]' direction='ASC'>
<dictionary>
