<text column='[federated.07nq8d80wcsg5x19smcei1sjevu1].[usr:Change up:nk]' />
<text column='[federated.07nq8d80wcsg5x19smcei1sjevu1].[usr:Change down:nk]' />
</encodings>

<customized-label>
<formatted-text>
<run bold='true' fontcolor='#1a2142' fontsize='9'>30+ DPD rate, latest month</run>
