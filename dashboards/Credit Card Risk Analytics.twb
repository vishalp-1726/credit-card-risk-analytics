<column caption='Dimension' datatype='string' name='[dimension]' role='dimension' type='nominal' />
<column caption='Segment' datatype='string' name='[segment]' role='dimension' type='nominal' />
<column caption='Accounts' datatype='integer' default-format='n#,##0' name='[accounts]' role='measure' type='quantitative' />
<column caption='Dpd30' datatype='integer' name='[dpd30]' role='measure' type='quantitative' />
<column caption='Dpd30 Rate' datatype='real' default-format='p0.00%' name='[dpd30_rate]' role='measure' type='quantitative' />
<column caption='Ci Low' datatype='real' default-format='p0.00%' name='[ci_low]' role='measure' type='quantitative' />
