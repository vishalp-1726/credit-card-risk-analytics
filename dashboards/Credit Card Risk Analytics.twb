<worksheet name='T3 Trade-off'>
<layout-options>
<title>
<formatted-text>
<run bold='true' fontcolor='#515151' fontname='Tableau Semibold' fontsize='10'>12-month bad rate at the same approvals: </run>
<run bold='true' fontcolor='#687387' fontname='Tableau Semibold' fontsize='10'>A one cut-off</run>
<run bold='true' fontcolor='#515151' fontname='Tableau Semibold' fontsize='10'> vs </run>
<run bold='true' fontcolor='#006de3' fontname='Tableau Semibold' fontsize='10'>B co-brand cut-off</run>
</formatted-text>
</title>
<caption>
<formatted-text>
<run>analysis as of Aug-2026</run>
</formatted-text>
</caption>
</layout-options>
<table>
<view>
<datasources>
<datasource caption='tradeoff' name='federated.05tql2e06k415j11ldlo40bdpls6' />
<datasource name='Parameters' />
</datasources>
<datasource-dependencies datasource='Parameters'>
<column caption='Approval rate' datatype='real' default-format='p0%' name='[Approval rate]' param-domain-type='list' role='measure' type='quantitative' value='0.9'>
<calculation class='tableau' formula='0.9' />
<members>
<member value='0.85' />
<member value='0.9' />
<member value='0.95' />
</members>
</column>
</datasource-dependencies>
<datasource-dependencies datasource='federated.05tql2e06k415j11ldlo40bdpls6'>
<column caption='Approval Target' datatype='real' default-format='p0%' name='[approval_target]' role='dimension' type='ordinal' />
<column caption='Cut One For All' datatype='integer' name='[cut_one_for_all]' role='measure' type='quantitative' />
<column caption='Cut Cobrand' datatype='integer' name='[cut_cobrand]' role='measure' type='quantitative' />
<column caption='Cut Other' datatype='integer' name='[cut_other]' role='measure' type='quantitative' />
<column caption='Cards Declined' datatype='integer' default-format='n#,##0' name='[cards_declined]' role='measure' type='quantitative' />
<column caption='Bad Rate All' datatype='real' name='[bad_rate_all]' role='measure' type='quantitative' />
<column caption='Bad Rate A' datatype='real' default-format='p0.00%' name='[bad_rate_a]' role='measure' type='quantitative' />
<column caption='Bad Rate B' datatype='real' default-format='p0.00%' name='[bad_rate_b]' role='measure' type='quantitative' />
<column caption='Bad Cards Avoided A' datatype='integer' name='[bad_cards_avoided_a]' role='measure' type='quantitative' />
<column caption='Bad Cards Avoided B' datatype='integer' name='[bad_cards_avoided_b]' role='measure' type='quantitative' />
<column caption='Bad A selected' datatype='real' default-format='p0.00%' name='[Bad A selected]' role='measure' type='quantitative'>
  <calculation class='tableau' formula='SUM(IF ROUND([approval_target], 2) = ROUND([Parameters].[Approval rate], 2) THEN [bad_rate_a] END)' />
</column>
<column caption='Bad B selected' datatype='real' default-format='p0.00%' name='[Bad B selected]' role='measure' type='quantitative'>
  <calculation class='tableau' formula='SUM(IF ROUND([approval_target], 2) = ROUND([Parameters].[Approval rate], 2) THEN [bad_rate_b] END)' />
</column>
<column caption='Is selected' datatype='boolean' name='[Is selected]' role='dimension' type='nominal'>
  <calculation class='tableau' formula='ROUND([approval_target], 2) = ROUND([Parameters].[Approval rate], 2)' />
</column>
<column caption='Dot size' datatype='real' name='[Dot size]' role='measure' type='quantitative'>
  <calculation class='tableau' formula='IF ROUND([approval_target], 2) = ROUND([Parameters].[Approval rate], 2) THEN 3 ELSE 2 END' />
</column>
<column-instance column='[approval_target]' derivation='None' name='[none:approval_target:ok]' pivot='key' type='ordinal' />
<column-instance column='[Dot size]' derivation='Sum' name='[sum:Dot size:qk]' pivot='key' type='quantitative' />
<column-instance column='[bad_cards_avoided_a]' derivation='Sum' name='[sum:bad_cards_avoided_a:qk]' pivot='key' type='quantitative' />
<column-instance column='[bad_cards_avoided_b]' derivation='Sum' name='[sum:bad_cards_avoided_b:qk]' pivot='key' type='quantitative' />
<column-instance column='[bad_rate_a]' derivation='Sum' name='[sum:bad_rate_a:qk]' pivot='key' type='quantitative' />
<column-instance column='[bad_rate_b]' derivation='Sum' name='[sum:bad_rate_b:qk]' pivot='key' type='quantitative' />
<column-instance column='[cards_declined]' derivation='Sum' name='[sum:cards_declined:qk]' pivot='key' type='quantitative' />
<column-instance column='[cut_cobrand]' derivation='Sum' name='[sum:cut_cobrand:qk]' pivot='key' type='quantitative' />
<column-instance column='[cut_one_for_all]' derivation='Sum' name='[sum:cut_one_for_all:qk]' pivot='key' type='quantitative' />
<column-instance column='[cut_other]' derivation='Sum' name='[sum:cut_other:qk]' pivot='key' type='quantitative' />
</datasource-dependencies>
<filter class='categorical' column='[federated.05tql2e06k415j11ldlo40bdpls6].[:Measure Names]'>
<groupfilter function='union' user:op='manual'>
<groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.05tql2e06k415j11ldlo40bdpls6].[sum:bad_rate_a:qk]&quot;' />
<groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.05tql2e06k415j11ldlo40bdpls6].[sum:bad_rate_b:qk]&quot;' />
</groupfilter>
</filter>
<sort class='manual' column='[federated.05tql2e06k415j11ldlo40bdpls6].[:Measure Names]' direction='ASC'>
<dictionary>
<bucket>&quot;[federated.05tql2e06k415j11ldlo40bdpls6].[sum:bad_rate_a:qk]&quot;</bucket>
<bucket>&quot;[federated.05tql2e06k415j11ldlo40bdpls6].[sum:bad_rate_b:qk]&quot;</bucket>
</dictionary>
</sort>
<slices>
<column>[federated.05tql2e06k415j11ldlo40bdpls6].[:Measure Names]</column>
</slices>
<aggregation value='true' />
</view>
