  <calculation class='tableau' formula='[dimension] = [Parameters].[Choose dimension]' />
</column>
<column caption='CI width' datatype='real' default-format='p0.00%' name='[CI width]' role='measure' type='quantitative'>
  <calculation class='tableau' formula='SUM([ci_high]) - SUM([ci_low])' />
</column>
<column caption='Book average' datatype='real' default-format='p0.00%' name='[Book average]' role='measure' type='quantitative'>
  <calculation class='tableau' formula='{FIXED [dimension] : SUM([dpd30]) / SUM([accounts])}' />
</column>
<column-instance column='[Book average]' derivation='Avg' name='[avg:Book average:qk]' pivot='key' type='quantitative' />
