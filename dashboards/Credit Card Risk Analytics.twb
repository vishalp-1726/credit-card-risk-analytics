<view>
<breakdown value='auto' />
</view>
<mark class='Bar' />
<encodings>
<color column='[federated.1d6viuk0kju93e1fdbdxh1edsqjv].[none:channel_group:nk]' />
<text column='[federated.1d6viuk0kju93e1fdbdxh1edsqjv].[sum:bad_6m_rate:qk]' />
<tooltip column='[federated.1d6viuk0kju93e1fdbdxh1edsqjv].[sum:cards:qk]' />
</encodings>


