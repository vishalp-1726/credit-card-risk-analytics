<worksheet name='D Same score'>
<layout-options>
<title>
<formatted-text>
<run bold='true' fontcolor='#0b0b0b' fontname='Tableau Semibold' fontsize='10'>Is co-brand worse only because of riskier customers?</run>
<run>Æ&#10;</run>
<run fontcolor='#eb6834' fontsize='9'>●</run>
<run fontcolor='#52514e' fontsize='8'> Fintech Co-brand   </run>
<run fontcolor='#2a78d6' fontsize='9'>●</run>
<run fontcolor='#52514e' fontsize='8'> other channels   </run>
<run fontcolor='#6b6a65' fontsize='8'>6-month bad rate, by bureau score</run>
</formatted-text>
</title>
</layout-options>
<table>
<view>
<datasources>
<datasource caption='same_score' name='federated.kg2i9plxjt8dcc9220eygdcli7u0' />
<datasource name='Parameters' />
</datasources>
<datasource-dependencies datasource='Parameters'>
<column caption='Statement month from' datatype='date' default-format='*mmm-yyyy' name='[Statement month from]' param-domain-type='list' role='measure' type='quantitative' value='#2024-09-01#'>
