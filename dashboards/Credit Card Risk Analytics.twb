<worksheet name='T3 KPI cures'>
<layout-options>
<title>
<formatted-text>
<run bold='true' fontcolor='#515151' fontname='Tableau Semibold' fontsize='10'>T3 KPI cures</run>
</formatted-text>
</title>
</layout-options>
<table>
<view>
<datasources>
<datasource caption='call_effect' name='federated.191hu4s1ocr3hq11jk4cm1w384zp' />
</datasources>
<datasource-dependencies datasource='federated.191hu4s1ocr3hq11jk4cm1w384zp'>
<column caption='Bucket' datatype='integer' name='[bucket]' role='measure' type='quantitative' />
<column caption='Metric' datatype='string' name='[metric]' role='dimension' type='nominal' />
<column caption='Called' datatype='real' default-format='p0.0%' name='[called]' role='measure' type='quantitative' />
<column caption='Called Ci' datatype='string' name='[called_ci]' role='dimension' type='nominal' />
<column caption='Not Called' datatype='real' default-format='p0.0%' name='[not_called]' role='measure' type='quantitative' />
<column caption='Difference' datatype='real' name='[difference]' role='measure' type='quantitative' />
<column caption='P Value' datatype='real' default-format='n#,##0.000' name='[p_value]' role='measure' type='quantitative' />
<column caption='N Called' datatype='integer' default-format='n#,##0' name='[n_called]' role='measure' type='quantitative' />
<column caption='N Not Called' datatype='integer' default-format='n#,##0' name='[n_not_called]' role='measure' type='quantitative' />
<column caption='Cure uplift 1-29' datatype='real' default-format='n+0.0;-0.0' name='[Cure uplift 1-29]' role='measure' type='quantitative'>
  <calculation class='tableau' formula='SUM(IF [metric] = &quot;cured&quot; AND [bucket] = 1 THEN [difference] END) * 100' />
</column>
<column caption='Cure uplift 30-59' datatype='real' default-format='n+0.0;-0.0' name='[Cure uplift 30-59]' role='measure' type='quantitative'>
  <calculation class='tableau' formula='SUM(IF [metric] = &quot;cured&quot; AND [bucket] = 2 THEN [difference] END) * 100' />
</column>
<column caption='DPD band' datatype='string' name='[DPD band]' role='dimension' type='nominal'>
  <calculation class='tableau' formula='CASE [bucket]&#10;  WHEN 1 THEN &quot;1: 1-29&quot;  WHEN 2 THEN &quot;2: 30-59&quot;  WHEN 3 THEN &quot;3: 60-89&quot;&#10;  WHEN 4 THEN &quot;4: 90-119&quot;  WHEN 5 THEN &quot;5: 120-149&quot;  WHEN 6 THEN &quot;6: 150-179&quot;&#10;END' />
</column>
<column caption='Show metric' datatype='boolean' name='[Show metric]' role='dimension' type='nominal'>
  <calculation class='tableau' formula='[metric] = [Parameters].[Choose metric]' />
</column>
<column-instance column='[Cure uplift 1-29]' derivation='User' name='[usr:Cure uplift 1-29:qk]' pivot='key' type='quantitative' />
<column-instance column='[Cure uplift 30-59]' derivation='User' name='[usr:Cure uplift 30-59:qk]' pivot='key' type='quantitative' />
</datasource-dependencies>



<aggregation value='true' />
</view>
<style>
<style-rule element='cell'>
<format attr='text-align' value='left' />
<format attr='vertical-align' value='center' />
</style-rule>
<style-rule element='table'>
<format attr='background-color' value='#ffffff' />
</style-rule>
