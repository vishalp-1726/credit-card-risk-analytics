<text column='[federated.1d6viuk0kju93e1fdbdxh1edsqjv].[usr:Highest ratio:qk]' />
</encodings>

<customized-label>
<formatted-text>
<run bold='true' fontcolor='#1a2142' fontsize='9'>Co-brand vs others, same bureau score</run>
<run>Æ&#10;</run>
<run bold='true' fontcolor='#006de3' fontsize='20'><![CDATA[<[federated.1d6viuk0kju93e1fdbdxh1edsqjv].[usr:Lowest ratio:qk]>]]></run>
<run bold='true' fontcolor='#006de3' fontsize='20'> – </run>
<run bold='true' fontcolor='#006de3' fontsize='20'><![CDATA[<[federated.1d6viuk0kju93e1fdbdxh1edsqjv].[usr:Highest ratio:qk]>]]></run>
