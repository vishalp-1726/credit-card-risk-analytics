<worksheets>
<worksheet name='T1 KPI rate'>
<layout-options>
<title>
<formatted-text>
<run bold='true' fontcolor='#515151' fontname='Tableau Semibold' fontsize='10'>T1 KPI rate</run>
</formatted-text>
</title>
</layout-options>
<table>
<view>
<datasources>
<datasource caption='kpi' name='federated.07nq8d80wcsg5x19smcei1sjevu1' />
</datasources>
<datasource-dependencies datasource='federated.07nq8d80wcsg5x19smcei1sjevu1'>
<column caption='Statement Month' datatype='date' name='[statement_month]' role='dimension' type='ordinal' />
<column caption='Active Accounts' datatype='integer' default-format='n#,##0' name='[active_accounts]' role='measure' type='quantitative' />
<column caption='Dpd30 Accounts' datatype='integer' name='[dpd30_accounts]' role='measure' type='quantitative' />
<column caption='Dpd30 Rate' datatype='real' default-format='p0.00%' name='[dpd30_rate]' role='measure' type='quantitative' />
<column caption='Dpd60 Rate' datatype='real' name='[dpd60_rate]' role='measure' type='quantitative' />
<column caption='Dpd90 Rate' datatype='real' name='[dpd90_rate]' role='measure' type='quantitative' />
<column caption='Dpd30 Balance Rate' datatype='real' default-format='p0.00%' name='[dpd30_balance_rate]' role='measure' type='quantitative' />
<column caption='Balance Crore' datatype='real' name='[balance_crore]' role='measure' type='quantitative' />
<column caption='Write Offs' datatype='integer' name='[write_offs]' role='measure' type='quantitative' />
<column caption='Write Off Crore' datatype='real' name='[write_off_crore]' role='measure' type='quantitative' />
<column caption='Latest month' datatype='date' name='[Latest month]' role='dimension' type='ordinal'>
  <calculation class='tableau' formula='{FIXED : MAX([statement_month])}' />
</column>
<column caption='Month from' datatype='date' name='[Month from]' role='dimension' type='ordinal'>
  <calculation class='tableau' formula='[statement_month]' />
</column>
<column caption='Year ago month' datatype='date' name='[Year ago month]' role='dimension' type='ordinal'>
  <calculation class='tableau' formula='DATEADD(&apos;year&apos;, -1, [Latest month])' />
</column>
<column caption='Rate latest' datatype='real' default-format='p0.00%' name='[Rate latest]' role='measure' type='quantitative'>
  <calculation class='tableau' formula='SUM(IF [statement_month] = [Latest month] THEN [dpd30_rate] END)' />
</column>
<column caption='Rate year ago' datatype='real' default-format='p0.00%' name='[Rate year ago]' role='measure' type='quantitative'>
  <calculation class='tableau' formula='SUM(IF [statement_month] = [Year ago month] THEN [dpd30_rate] END)' />
</column>
<column caption='Change pts' datatype='real' name='[Change pts]' role='measure' type='quantitative'>
  <calculation class='tableau' formula='([Rate latest] - [Rate year ago]) * 100' />
</column>
<column caption='Change up' datatype='string' name='[Change up]' role='measure' type='nominal'>
  <calculation class='tableau' formula='IF [Change pts] &gt; 0 THEN &quot;▲ +&quot; + STR(ROUND([Change pts], 2)) + &quot; pts vs a year ago (&quot;&#10;    + STR(ROUND([Rate year ago] * 100, 2)) + &quot;%)&quot; END' />
</column>
<column caption='Change down' datatype='string' name='[Change down]' role='measure' type='nominal'>
  <calculation class='tableau' formula='IF [Change pts] &lt;= 0 THEN &quot;▼ &quot; + STR(ROUND([Change pts], 2)) + &quot; pts vs a year ago (&quot;&#10;    + STR(ROUND([Rate year ago] * 100, 2)) + &quot;%)&quot; END' />
</column>
<column caption='Accounts latest' datatype='integer' default-format='n#,##0' name='[Accounts latest]' role='measure' type='quantitative'>
  <calculation class='tableau' formula='SUM(IF [statement_month] = [Latest month] THEN [active_accounts] END)' />
</column>
<column caption='Accounts rate now' datatype='real' default-format='p0.00%' name='[Accounts rate now]' role='measure' type='quantitative'>
  <calculation class='tableau' formula='{FIXED : SUM(IF [statement_month] = [Latest month] THEN [dpd30_rate] END)}' />
</column>
<column caption='Balance rate now' datatype='real' default-format='p0.00%' name='[Balance rate now]' role='measure' type='quantitative'>
  <calculation class='tableau' formula='{FIXED : SUM(IF [statement_month] = [Latest month] THEN [dpd30_balance_rate] END)}' />
</column>
<column caption='Write-offs latest' datatype='integer' default-format='n#,##0' name='[Write-offs latest]' role='measure' type='quantitative'>
  <calculation class='tableau' formula='SUM(IF [statement_month] = [Latest month] THEN [write_offs] END)' />
</column>
<column caption='Data month label' datatype='string' name='[Data month label]' role='dimension' type='nominal'>
  <calculation class='tableau' formula='&quot;Data to &quot; + LEFT(DATENAME(&apos;month&apos;, [Latest month]), 3) + &quot;-&quot; + DATENAME(&apos;year&apos;, [Latest month])' />
</column>
<column-instance column='[Change down]' derivation='User' name='[usr:Change down:nk]' pivot='key' type='nominal' />
<column-instance column='[Change up]' derivation='User' name='[usr:Change up:nk]' pivot='key' type='nominal' />
<column-instance column='[Rate latest]' derivation='User' name='[usr:Rate latest:qk]' pivot='key' type='quantitative' />
</datasource-dependencies>



<aggregation value='true' />
</view>
<style>
<style-rule element='cell'>
<format attr='text-align' value='left' />
<format attr='vertical-align' value='center' />
</style-rule>
<style-rule element='table'>
<format attr='background-color' value='#ffffff' />
</style-rule>
</style>
<panes>
<pane selection-relaxation-option='selection-relaxation-allow'>
<view>
<breakdown value='auto' />
</view>
