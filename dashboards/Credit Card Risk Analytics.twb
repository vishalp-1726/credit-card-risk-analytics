<worksheet name='O Change by part'>
<layout-options>
<title>
<formatted-text>
<run bold='true' fontcolor='#0b0b0b' fontname='Tableau Semibold' fontsize='10'>Where did the extra 30+ accounts come from?</run>
<run>Æ&#10;</run>
<run fontcolor='#eb6834' fontsize='9'>●</run>
<run fontcolor='#52514e' fontsize='8'> co-brand   </run>
<run fontcolor='#1d9a8a' fontsize='9'>●</run>
<run fontcolor='#52514e' fontsize='8'> rest of the book   </run>
<run fontcolor='#6b6a65' fontsize='8'>change in 30+ accounts, 12 months to </run>
<run fontcolor='#6b6a65' fontsize='8'><![CDATA[<[Parameters].[Statement month to]>]]></run>
</formatted-text>
</title>
</layout-options>
