<worksheet name='T2 Same score'>
<layout-options>
<title>
<formatted-text>
<run bold='true' fontcolor='#515151' fontname='Tableau Semibold' fontsize='10'>6-month bad rate at the same bureau score: </run>
<run bold='true' fontcolor='#b85c00' fontname='Tableau Semibold' fontsize='10'>Fintech Co-brand</run>
<run bold='true' fontcolor='#515151' fontname='Tableau Semibold' fontsize='10'> vs </run>
<run bold='true' fontcolor='#006de3' fontname='Tableau Semibold' fontsize='10'>other channels</run>
</formatted-text>
</title>
<caption>
<formatted-text>
<run>analysis as of Aug-2026</run>
</formatted-text>
</caption>
</layout-options>
<table>
<view>
<datasources>
<datasource caption='same_score' name='federated.1d6viuk0kju93e1fdbdxh1edsqjv' />
</datasources>
<datasource-dependencies datasource='federated.1d6viuk0kju93e1fdbdxh1edsqjv'>
<column caption='Score Band' datatype='string' name='[score_band]' role='dimension' type='nominal' />
<column caption='Cards' datatype='integer' default-format='n#,##0' name='[cards]' role='measure' type='quantitative' />
<column caption='Bad 6m Rate' datatype='real' default-format='p0.0%' name='[bad_6m_rate]' role='measure' type='quantitative' />
<column caption='Channel Group' datatype='string' name='[channel_group]' role='dimension' type='nominal' />
<column caption='Ratio by band' datatype='real' name='[Ratio by band]' role='measure' type='quantitative'>
  <calculation class='tableau' formula='{FIXED [score_band] :&#10;    SUM(IF [channel_group] = &quot;Fintech Co-brand&quot; THEN [bad_6m_rate] END)&#10;  / SUM(IF [channel_group] = &quot;Other channels&quot; THEN [bad_6m_rate] END)}' />
</column>
<column caption='Lowest ratio' datatype='real' default-format='n#,##0.0' name='[Lowest ratio]' role='measure' type='quantitative'>
  <calculation class='tableau' formula='MIN([Ratio by band])' />
</column>
<column caption='Highest ratio' datatype='real' default-format='n#,##0.0' name='[Highest ratio]' role='measure' type='quantitative'>
  <calculation class='tableau' formula='MAX([Ratio by band])' />
</column>
<column-instance column='[channel_group]' derivation='None' name='[none:channel_group:nk]' pivot='key' type='nominal' />
<column-instance column='[score_band]' derivation='None' name='[none:score_band:nk]' pivot='key' type='nominal' />
<column-instance column='[bad_6m_rate]' derivation='Sum' name='[sum:bad_6m_rate:qk]' pivot='key' type='quantitative' />
<column-instance column='[cards]' derivation='Sum' name='[sum:cards:qk]' pivot='key' type='quantitative' />
</datasource-dependencies>

<sort class='manual' column='[federated.1d6viuk0kju93e1fdbdxh1edsqjv].[none:score_band:nk]' direction='ASC'>
<dictionary>
<bucket>&quot;&lt;500&quot;</bucket>
<bucket>&quot;500-599&quot;</bucket>
<bucket>&quot;600-699&quot;</bucket>
<bucket>&quot;700+&quot;</bucket>
</dictionary>
</sort>

<aggregation value='true' />
</view>
<style>
<style-rule element='axis'>
<format attr='title' class='0' field='[federated.1d6viuk0kju93e1fdbdxh1edsqjv].[sum:bad_6m_rate:qk]' scope='rows' value='' />
<format attr='subtitle' class='0' field='[federated.1d6viuk0kju93e1fdbdxh1edsqjv].[sum:bad_6m_rate:qk]' scope='rows' value='' />
</style-rule>
<style-rule element='label'>
<format attr='display' field='[federated.1d6viuk0kju93e1fdbdxh1edsqjv].[none:channel_group:nk]' value='false' />
<format attr='text-format' field='[federated.1d6viuk0kju93e1fdbdxh1edsqjv].[sum:bad_6m_rate:qk]' value='p0%' />
</style-rule>
<style-rule element='worksheet'>
<format attr='display-field-labels' scope='cols' value='false' />
</style-rule>
</style>
