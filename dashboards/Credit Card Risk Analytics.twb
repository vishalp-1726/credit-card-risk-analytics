<worksheet name='T3 Call effect'>
<layout-options>
<title>
<formatted-text>
<run bold='true' fontcolor='#515151' fontname='Tableau Semibold' fontsize='10'><![CDATA[<[Parameters].[Choose metric]>]]></run>
<run bold='true' fontcolor='#515151' fontname='Tableau Semibold' fontsize='10'>: </run>
<run bold='true' fontcolor='#687387' fontname='Tableau Semibold' fontsize='10'>not called</run>
<run bold='true' fontcolor='#515151' fontname='Tableau Semibold' fontsize='10'> vs </run>
<run bold='true' fontcolor='#006de3' fontname='Tableau Semibold' fontsize='10'>called (random test)</run>
</formatted-text>
</title>
<caption>
<formatted-text>
<run>analysis as of Aug-2026</run>
</formatted-text>
</caption>
</layout-options>
<table>
<view>
<datasources>
<datasource caption='call_effect' name='federated.191hu4s1ocr3hq11jk4cm1w384zp' />
<datasource name='Parameters' />
</datasources>
<datasource-dependencies datasource='Parameters'>
<column alias='Cured in the month' caption='Choose metric' datatype='string' name='[Choose metric]' param-domain-type='list' role='measure' type='nominal' value='&quot;cured&quot;'>
<calculation class='tableau' formula='&quot;cured&quot;' />
<aliases>
<alias key='&quot;cured&quot;' value='Cured in the month' />
<alias key='&quot;written_off_6m&quot;' value='Written off within 6 months' />
</aliases>
<members>
<member alias='Cured in the month' value='&quot;cured&quot;' />
<member alias='Written off within 6 months' value='&quot;written_off_6m&quot;' />
</members>
</column>
</datasource-dependencies>
<datasource-dependencies datasource='federated.191hu4s1ocr3hq11jk4cm1w384zp'>
<column caption='Bucket' datatype='integer' name='[bucket]' role='measure' type='quantitative' />
<column caption='Metric' datatype='string' name='[metric]' role='dimension' type='nominal' />
<column caption='Called' datatype='real' default-format='p0.0%' name='[called]' role='measure' type='quantitative' />
<column caption='Called Ci' datatype='string' name='[called_ci]' role='dimension' type='nominal' />
<column caption='Not Called' datatype='real' default-format='p0.0%' name='[not_called]' role='measure' type='quantitative' />
<column caption='Difference' datatype='real' name='[difference]' role='measure' type='quantitative' />
<column caption='P Value' datatype='real' default-format='n#,##0.000' name='[p_value]' role='measure' type='quantitative' />
<column caption='N Called' datatype='integer' default-format='n#,##0' name='[n_called]' role='measure' type='quantitative' />
<column caption='N Not Called' datatype='integer' default-format='n#,##0' name='[n_not_called]' role='measure' type='quantitative' />
<column caption='Cure uplift 1-29' datatype='real' default-format='n+0.0;-0.0' name='[Cure uplift 1-29]' role='measure' type='quantitative'>
  <calculation class='tableau' formula='SUM(IF [metric] = &quot;cured&quot; AND [bucket] = 1 THEN [difference] END) * 100' />
</column>
<column caption='Cure uplift 30-59' datatype='real' default-format='n+0.0;-0.0' name='[Cure uplift 30-59]' role='measure' type='quantitative'>
  <calculation class='tableau' formula='SUM(IF [metric] = &quot;cured&quot; AND [bucket] = 2 THEN [difference] END) * 100' />
</column>
<column caption='DPD band' datatype='string' name='[DPD band]' role='dimension' type='nominal'>
  <calculation class='tableau' formula='CASE [bucket]&#10;  WHEN 1 THEN &quot;1: 1-29&quot;  WHEN 2 THEN &quot;2: 30-59&quot;  WHEN 3 THEN &quot;3: 60-89&quot;&#10;  WHEN 4 THEN &quot;4: 90-119&quot;  WHEN 5 THEN &quot;5: 120-149&quot;  WHEN 6 THEN &quot;6: 150-179&quot;&#10;END' />
</column>
<column caption='Show metric' datatype='boolean' name='[Show metric]' role='dimension' type='nominal'>
  <calculation class='tableau' formula='[metric] = [Parameters].[Choose metric]' />
</column>
<column-instance column='[called_ci]' derivation='Attribute' name='[attr:called_ci:nk]' pivot='key' type='nominal' />
<column-instance column='[DPD band]' derivation='None' name='[none:DPD band:nk]' pivot='key' type='nominal' />
<column-instance column='[Show metric]' derivation='None' name='[none:Show metric:nk]' pivot='key' type='nominal' />
<column-instance column='[called]' derivation='Sum' name='[sum:called:qk]' pivot='key' type='quantitative' />
<column-instance column='[n_called]' derivation='Sum' name='[sum:n_called:qk]' pivot='key' type='quantitative' />
<column-instance column='[not_called]' derivation='Sum' name='[sum:not_called:qk]' pivot='key' type='quantitative' />
<column-instance column='[p_value]' derivation='Sum' name='[sum:p_value:qk]' pivot='key' type='quantitative' />
</datasource-dependencies>
<filter class='categorical' column='[federated.191hu4s1ocr3hq11jk4cm1w384zp].[:Measure Names]'>
<groupfilter function='union' user:op='manual'>
<groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.191hu4s1ocr3hq11jk4cm1w384zp].[sum:not_called:qk]&quot;' />
<groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.191hu4s1ocr3hq11jk4cm1w384zp].[sum:called:qk]&quot;' />
</groupfilter>
</filter>
<filter class='categorical' column='[federated.191hu4s1ocr3hq11jk4cm1w384zp].[none:Show metric:nk]'>
<groupfilter function='member' level='[none:Show metric:nk]' member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
</filter>
<sort class='manual' column='[federated.191hu4s1ocr3hq11jk4cm1w384zp].[:Measure Names]' direction='ASC'>
<dictionary>
<bucket>&quot;[federated.191hu4s1ocr3hq11jk4cm1w384zp].[sum:not_called:qk]&quot;</bucket>
<bucket>&quot;[federated.191hu4s1ocr3hq11jk4cm1w384zp].[sum:called:qk]&quot;</bucket>
</dictionary>
</sort>
<slices>
<column>[federated.191hu4s1ocr3hq11jk4cm1w384zp].[:Measure Names]</column>
<column>[federated.191hu4s1ocr3hq11jk4cm1w384zp].[none:Show metric:nk]</column>
</slices>
<aggregation value='true' />
</view>
<style>
<style-rule element='axis'>
<format attr='title' class='0' field='[federated.191hu4s1ocr3hq11jk4cm1w384zp].[Multiple Values]' scope='rows' value='' />
<format attr='subtitle' class='0' field='[federated.191hu4s1ocr3hq11jk4cm1w384zp].[Multiple Values]' scope='rows' value='' />
