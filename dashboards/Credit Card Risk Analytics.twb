<column caption='Write-offs up' datatype='string' name='[Write-offs up]' role='dimension' type='nominal'>
  <calculation class='tableau' formula='IF [Write-offs chg] &gt; 0 THEN &quot;▲ &quot; END' />
</column>
<column caption='Write-offs down' datatype='string' name='[Write-offs down]' role='dimension' type='nominal'>
