<column caption='Channel group' datatype='string' name='[Channel group]' role='dimension' type='nominal'>
  <calculation class='tableau' formula='IIF([channel] = &quot;Fintech Co-brand&quot;, &quot;Fintech Co-brand&quot;, &quot;Other channels&quot;)' />
</column>
<column caption='Keep' datatype='boolean' name='[Keep]' role='dimension' type='nominal'>
  <calculation class='tableau' formula='([Parameters].[Bureau score band] = &quot;(All)&quot; OR [score_band] = [Parameters].[Bureau score band])' />
</column>
<column caption='In month range' datatype='boolean' name='[In month range]' role='dimension' type='nominal'>
  <calculation class='tableau' formula='IIF([Parameters].[Statement month from] &lt;= [Parameters].[Statement month to], [statement_month] &gt;= [Parameters].[Statement month from] AND [statement_month] &lt;= [Parameters].[Statement month to],&#10;    [statement_month] &gt;= [Parameters].[Statement month to] AND [statement_month] &lt;= [Parameters].[Statement month from])' />
</column>
<column caption='Last 13 months' datatype='boolean' name='[Last 13 months]' role='dimension' type='nominal'>
  <calculation class='tableau' formula='[statement_month] &gt;= DATEADD(&apos;month&apos;, -12, [Parameters].[Statement month to]) AND [statement_month] &lt;= [Parameters].[Statement month to]' />
</column>
<column caption='Is to month' datatype='boolean' name='[Is to month]' role='dimension' type='nominal'>
  <calculation class='tableau' formula='[statement_month] = [Parameters].[Statement month to]' />
</column>
<column caption='30+ rate' datatype='real' default-format='p0.00%' name='[30+ rate]' role='measure' type='quantitative'>
  <calculation class='tableau' formula='SUM([dpd30_accounts]) / SUM([active_accounts])' />
</column>
<column caption='30+ rate by balance' datatype='real' default-format='p0.00%' name='[30+ rate by balance]' role='measure' type='quantitative'>
  <calculation class='tableau' formula='SUM([dpd30_balance]) / SUM([balance])' />
</column>
<column caption='Rate now' datatype='real' default-format='p0.00%' name='[Rate now]' role='measure' type='quantitative'>
  <calculation class='tableau' formula='SUM(IF [statement_month] = [Parameters].[Statement month to] THEN [dpd30_accounts] END)&#10;/ SUM(IF [statement_month] = [Parameters].[Statement month to] THEN [active_accounts] END)' />
</column>
<column caption='Rate year ago' datatype='real' default-format='p0.00%' name='[Rate year ago]' role='measure' type='quantitative'>
  <calculation class='tableau' formula='SUM(IF [statement_month] = DATEADD(&apos;month&apos;, -12, [Parameters].[Statement month to]) THEN [dpd30_accounts] END)&#10;/ SUM(IF [statement_month] = DATEADD(&apos;month&apos;, -12, [Parameters].[Statement month to]) THEN [active_accounts] END)' />
</column>
<column caption='Change pts' datatype='real' default-format='n+0.00;-0.00' name='[Change pts]' role='measure' type='quantitative'>
  <calculation class='tableau' formula='([Rate now] - [Rate year ago]) * 100' />
</column>
<column caption='Accounts now' datatype='integer' default-format='n#,##0' name='[Accounts now]' role='measure' type='quantitative'>
  <calculation class='tableau' formula='SUM(IF [statement_month] = [Parameters].[Statement month to] THEN [active_accounts] END)' />
</column>
<column caption='Accounts year ago' datatype='integer' default-format='n#,##0' name='[Accounts year ago]' role='measure' type='quantitative'>
  <calculation class='tableau' formula='SUM(IF [statement_month] = DATEADD(&apos;month&apos;, -12, [Parameters].[Statement month to]) THEN [active_accounts] END)' />
</column>
<column caption='Accounts growth' datatype='real' default-format='p+0%;-0%' name='[Accounts growth]' role='measure' type='quantitative'>
  <calculation class='tableau' formula='[Accounts now] / [Accounts year ago] - 1' />
</column>
<column caption='Write-offs now' datatype='integer' default-format='n#,##0' name='[Write-offs now]' role='measure' type='quantitative'>
  <calculation class='tableau' formula='SUM(IF [statement_month] = [Parameters].[Statement month to] THEN [write_offs] END)' />
</column>
<column caption='Write-offs year ago' datatype='integer' default-format='n#,##0' name='[Write-offs year ago]' role='measure' type='quantitative'>
  <calculation class='tableau' formula='SUM(IF [statement_month] = DATEADD(&apos;month&apos;, -12, [Parameters].[Statement month to]) THEN [write_offs] END)' />
</column>
<column caption='Co-brand new now' datatype='real' default-format='p0.00%' name='[Co-brand new now]' role='measure' type='quantitative'>
  <calculation class='tableau' formula='SUM(IF [statement_month] = [Parameters].[Statement month to] AND [channel] = &quot;Fintech Co-brand&quot; AND [book_part] = &quot;New cards&quot; THEN [dpd30_accounts] END)&#10;/ SUM(IF [statement_month] = [Parameters].[Statement month to] AND [channel] = &quot;Fintech Co-brand&quot; AND [book_part] = &quot;New cards&quot; THEN [active_accounts] END)' />
</column>
<column caption='Other new now' datatype='real' default-format='p0.00%' name='[Other new now]' role='measure' type='quantitative'>
  <calculation class='tableau' formula='SUM(IF [statement_month] = [Parameters].[Statement month to] AND [channel] &lt;&gt; &quot;Fintech Co-brand&quot; AND [book_part] = &quot;New cards&quot; THEN [dpd30_accounts] END)&#10;/ SUM(IF [statement_month] = [Parameters].[Statement month to] AND [channel] &lt;&gt; &quot;Fintech Co-brand&quot; AND [book_part] = &quot;New cards&quot; THEN [active_accounts] END)' />
</column>
<column caption='Co-brand multiple' datatype='real' default-format='n#,##0.0' name='[Co-brand multiple]' role='measure' type='quantitative'>
  <calculation class='tableau' formula='[Co-brand new now] / [Other new now]' />
</column>
<column caption='Existing now' datatype='real' default-format='p0.00%' name='[Existing now]' role='measure' type='quantitative'>
  <calculation class='tableau' formula='SUM(IF [statement_month] = [Parameters].[Statement month to] AND [book_part] = &quot;Existing book&quot; THEN [dpd30_accounts] END)&#10;/ SUM(IF [statement_month] = [Parameters].[Statement month to] AND [book_part] = &quot;Existing book&quot; THEN [active_accounts] END)' />
</column>
<column caption='Existing year ago' datatype='real' default-format='p0.00%' name='[Existing year ago]' role='measure' type='quantitative'>
  <calculation class='tableau' formula='SUM(IF [statement_month] = DATEADD(&apos;month&apos;, -12, [Parameters].[Statement month to]) AND [book_part] = &quot;Existing book&quot; THEN [dpd30_accounts] END)&#10;/ SUM(IF [statement_month] = DATEADD(&apos;month&apos;, -12, [Parameters].[Statement month to]) AND [book_part] = &quot;Existing book&quot; THEN [active_accounts] END)' />
</column>
<column caption='Is new card' datatype='boolean' name='[Is new card]' role='dimension' type='nominal'>
  <calculation class='tableau' formula='[book_part] = &quot;New cards&quot;' />
</column>
<column caption='New card group' datatype='string' name='[New card group]' role='dimension' type='nominal'>
  <calculation class='tableau' formula='IF [book_part] = &quot;New cards&quot; THEN IIF([channel] = &quot;Fintech Co-brand&quot;, &quot;Co-brand&quot;, &quot;Other&quot;) END' />
</column>
<column caption='Book part 3' datatype='string' name='[Book part 3]' role='dimension' type='nominal'>
  <calculation class='tableau' formula='IF [book_part] = &quot;Existing book&quot; THEN &quot;Existing book (opened before Apr-2025)&quot;&#10;ELSEIF [channel] = &quot;Fintech Co-brand&quot; THEN &quot;New cards: Fintech Co-brand&quot;&#10;ELSE &quot;New cards: other channels&quot; END' />
</column>
<column caption='Is co-brand part' datatype='boolean' name='[Is co-brand part]' role='dimension' type='nominal'>
  <calculation class='tableau' formula='CONTAINS([Book part 3], &quot;Co-brand&quot;)' />
</column>
<column caption='Change in 30+ accounts' datatype='integer' default-format='n+#,##0;-#,##0' name='[Change in 30+ accounts]' role='measure' type='quantitative'>
  <calculation class='tableau' formula='ZN(SUM(IF [statement_month] = [Parameters].[Statement month to] THEN [dpd30_accounts] END)) - ZN(SUM(IF [statement_month] = DATEADD(&apos;month&apos;, -12, [Parameters].[Statement month to]) THEN [dpd30_accounts] END))' />
</column>
<column caption='Channel rate now' datatype='real' default-format='p0.0%' name='[Channel rate now]' role='measure' type='quantitative'>
  <calculation class='tableau' formula='{FIXED [channel] : SUM(IF [statement_month] = [Parameters].[Statement month to] THEN [dpd30_accounts] END) / SUM(IF [statement_month] = [Parameters].[Statement month to] THEN [active_accounts] END)}' />
</column>
<column caption='Co-brand now' datatype='real' default-format='p0.0%' name='[Co-brand now]' role='measure' type='quantitative'>
  <calculation class='tableau' formula='SUM(IF [statement_month] = [Parameters].[Statement month to] AND [channel] = &quot;Fintech Co-brand&quot; THEN [dpd30_accounts] END)&#10;/ SUM(IF [statement_month] = [Parameters].[Statement month to] AND [channel] = &quot;Fintech Co-brand&quot; THEN [active_accounts] END)' />
</column>
<column caption='Other channels low' datatype='real' default-format='p0.0%' name='[Other channels low]' role='measure' type='quantitative'>
  <calculation class='tableau' formula='MIN(IF [channel] &lt;&gt; &quot;Fintech Co-brand&quot; THEN [Channel rate now] END)' />
</column>
<column caption='Other channels high' datatype='real' default-format='p0.0%' name='[Other channels high]' role='measure' type='quantitative'>
  <calculation class='tableau' formula='MAX(IF [channel] &lt;&gt; &quot;Fintech Co-brand&quot; THEN [Channel rate now] END)' />
</column>
<column caption='Utilisation group' datatype='string' name='[Utilisation group]' role='dimension' type='nominal'>
  <calculation class='tableau' formula='IF [util_band] = &quot;3: 70-90%&quot; OR [util_band] = &quot;4: 90%+&quot; THEN &quot;70%+&quot;&#10;ELSEIF [util_band] &lt;&gt; &quot;Missing&quot; THEN &quot;below 70%&quot; END' />
</column>
<column caption='High util now' datatype='real' default-format='p0.00%' name='[High util now]' role='measure' type='quantitative'>
  <calculation class='tableau' formula='SUM(IF [statement_month] = [Parameters].[Statement month to] AND [book_part] = &quot;Existing book&quot; AND ([util_band] = &quot;3: 70-90%&quot; OR [util_band] = &quot;4: 90%+&quot;) THEN [dpd30_accounts] END)&#10;/ SUM(IF [statement_month] = [Parameters].[Statement month to] AND [book_part] = &quot;Existing book&quot; AND ([util_band] = &quot;3: 70-90%&quot; OR [util_band] = &quot;4: 90%+&quot;) THEN [active_accounts] END)' />
</column>
<column caption='High util year ago' datatype='real' default-format='p0.00%' name='[High util year ago]' role='measure' type='quantitative'>
  <calculation class='tableau' formula='SUM(IF [statement_month] = DATEADD(&apos;month&apos;, -12, [Parameters].[Statement month to]) AND [book_part] = &quot;Existing book&quot; AND ([util_band] = &quot;3: 70-90%&quot; OR [util_band] = &quot;4: 90%+&quot;) THEN [dpd30_accounts] END)&#10;/ SUM(IF [statement_month] = DATEADD(&apos;month&apos;, -12, [Parameters].[Statement month to]) AND [book_part] = &quot;Existing book&quot; AND ([util_band] = &quot;3: 70-90%&quot; OR [util_band] = &quot;4: 90%+&quot;) THEN [active_accounts] END)' />
</column>
<column caption='Is existing, util known' datatype='boolean' name='[Is existing, util known]' role='dimension' type='nominal'>
  <calculation class='tableau' formula='[book_part] = &quot;Existing book&quot; AND [util_band] &lt;&gt; &quot;Missing&quot;' />
</column>
<column caption='Segment' datatype='string' name='[Segment]' role='dimension' type='nominal'>
  <calculation class='tableau' formula='CASE [Parameters].[Segments chart: split by]&#10;  WHEN &quot;Channel&quot; THEN [channel]&#10;  WHEN &quot;Bureau score&quot; THEN CASE [score_band] WHEN &quot;&lt;500&quot; THEN &quot;1: &lt;500&quot; WHEN &quot;500-599&quot; THEN &quot;2: 500-599&quot;&#10;  WHEN &quot;600-699&quot; THEN &quot;3: 600-699&quot; WHEN &quot;700+&quot; THEN &quot;4: 700+&quot; ELSE &quot;Missing&quot; END&#10;  WHEN &quot;Utilisation&quot; THEN [util_band]&#10;  WHEN &quot;Income type&quot; THEN [income_type]&#10;  WHEN &quot;City tier&quot; THEN [city_tier]&#10;  WHEN &quot;Age band&quot; THEN [age_band]&#10;END' />
</column>
<column caption='Accounts' datatype='integer' default-format='n#,##0' name='[Accounts]' role='measure' type='quantitative'>
  <calculation class='tableau' formula='SUM([active_accounts])' />
</column>
<column caption='Big enough' datatype='boolean' name='[Big enough]' role='dimension' type='nominal'>
  <calculation class='tableau' formula='SUM([active_accounts]) &gt;= 30' />
</column>
<column caption='CI low' datatype='real' default-format='p0.00%' name='[CI low]' role='measure' type='quantitative'>
  <calculation class='tableau' formula='(([30+ rate] + 1.96^2 / (2 * SUM([active_accounts]))) - 1.96 * SQRT([30+ rate] * (1 - [30+ rate]) / SUM([active_accounts]) + 1.96^2 / (4 * SUM([active_accounts])^2)))&#10;/ (1 + 1.96^2 / SUM([active_accounts]))' />
</column>
<column caption='CI high' datatype='real' default-format='p0.00%' name='[CI high]' role='measure' type='quantitative'>
  <calculation class='tableau' formula='(([30+ rate] + 1.96^2 / (2 * SUM([active_accounts]))) + 1.96 * SQRT([30+ rate] * (1 - [30+ rate]) / SUM([active_accounts]) + 1.96^2 / (4 * SUM([active_accounts])^2)))&#10;/ (1 + 1.96^2 / SUM([active_accounts]))' />
</column>
<column caption='CI width' datatype='real' default-format='p0.00%' name='[CI width]' role='measure' type='quantitative'>
  <calculation class='tableau' formula='[CI high] - [CI low]' />
</column>
<column caption='Book average' datatype='real' default-format='p0.00%' name='[Book average]' role='measure' type='quantitative'>
  <calculation class='tableau' formula='{FIXED : SUM(IF [statement_month] = [Parameters].[Statement month to] THEN [dpd30_accounts] END) / SUM(IF [statement_month] = [Parameters].[Statement month to] THEN [active_accounts] END)}' />
</column>
<column caption='Existing rate' datatype='real' default-format='p0.00%' name='[Existing rate]' role='measure' type='quantitative'>
  <calculation class='tableau' formula='SUM(IF [book_part] = &quot;Existing book&quot; THEN [dpd30_accounts] END) / SUM(IF [book_part] = &quot;Existing book&quot; THEN [active_accounts] END)' />
</column>
<column caption='High util rate' datatype='real' default-format='p0.00%' name='[High util rate]' role='measure' type='quantitative'>
  <calculation class='tableau' formula='SUM(IF [book_part] = &quot;Existing book&quot; AND ([util_band] = &quot;3: 70-90%&quot; OR [util_band] = &quot;4: 90%+&quot;) THEN [dpd30_accounts] END)&#10;/ SUM(IF [book_part] = &quot;Existing book&quot; AND ([util_band] = &quot;3: 70-90%&quot; OR [util_band] = &quot;4: 90%+&quot;) THEN [active_accounts] END)' />
</column>
<column caption='Rate chg' datatype='real' name='[Rate chg]' role='measure' type='quantitative'>
  <calculation class='tableau' formula='[Rate now] - [Rate year ago]' />
</column>
<column caption='Rate dir' datatype='string' name='[Rate dir]' role='dimension' type='nominal'>
  <calculation class='tableau' formula='IF [Rate chg] &gt; 0 THEN &quot;worse&quot; ELSEIF [Rate chg] &lt; 0 THEN &quot;better&quot; ELSE &quot;neutral&quot; END' />
</column>
<column caption='Rate up' datatype='string' name='[Rate up]' role='dimension' type='nominal'>
  <calculation class='tableau' formula='IF [Rate chg] &gt; 0 THEN &quot;▲ &quot; END' />
</column>
<column caption='Rate down' datatype='string' name='[Rate down]' role='dimension' type='nominal'>
  <calculation class='tableau' formula='IF [Rate chg] &lt; 0 THEN &quot;▼ &quot; END' />
</column>
<column caption='Rate same' datatype='string' name='[Rate same]' role='dimension' type='nominal'>
  <calculation class='tableau' formula='IF [Rate chg] = 0 THEN &quot;no change&quot; END' />
</column>
<column caption='Rate worse n' datatype='real' default-format='n0.00&quot; pts&quot;' name='[Rate worse n]' role='measure' type='quantitative'>
  <calculation class='tableau' formula='IF [Rate chg] &gt; 0 THEN ABS(([Rate now] - [Rate year ago]) * 100) END' />
</column>
<column caption='Rate better n' datatype='real' default-format='n0.00&quot; pts&quot;' name='[Rate better n]' role='measure' type='quantitative'>
  <calculation class='tableau' formula='IF [Rate chg] &lt; 0 THEN ABS(([Rate now] - [Rate year ago]) * 100) END' />
</column>
<column caption='One' datatype='real' name='[One]' role='measure' type='quantitative'>
  <calculation class='tableau' formula='MIN(1)' />
</column>
<column caption='Zero' datatype='real' name='[Zero]' role='measure' type='quantitative'>
  <calculation class='tableau' formula='MIN(0)' />
</column>
