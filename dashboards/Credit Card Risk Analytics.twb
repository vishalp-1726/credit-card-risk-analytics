<worksheet name='T2 Utilisation'>
<layout-options>
<title>
<formatted-text>
<run bold='true' fontcolor='#515151' fontname='Tableau Semibold' fontsize='10'>Existing book 30+ rate: </run>
<run bold='true' fontcolor='#006de3' fontname='Tableau Semibold' fontsize='10'>utilisation 70%+</run>
<run bold='true' fontcolor='#515151' fontname='Tableau Semibold' fontsize='10'> vs </run>
<run bold='true' fontcolor='#687387' fontname='Tableau Semibold' fontsize='10'>below 70%</run>
</formatted-text>
</title>
<caption>
<formatted-text>
<run>analysis as of Aug-2026</run>
</formatted-text>
</caption>
</layout-options>
<table>
<view>
<datasources>
<datasource caption='util' name='federated.1bx3v15186r6em0zp6g141tyrfzk' />
</datasources>
<datasource-dependencies datasource='federated.1bx3v15186r6em0zp6g141tyrfzk'>
<column caption='Statement Month' datatype='date' name='[statement_month]' role='dimension' type='ordinal' />
<column caption='High Util' datatype='boolean' name='[high_util]' role='dimension' type='nominal' />
<column caption='Accounts' datatype='integer' name='[accounts]' role='measure' type='quantitative' />
<column caption='Dpd30 Rate' datatype='real' default-format='p0.00%' name='[dpd30_rate]' role='measure' type='quantitative' />
<column caption='Util last month' datatype='date' name='[Util last month]' role='dimension' type='ordinal'>
  <calculation class='tableau' formula='{FIXED : MAX([statement_month])}' />
</column>
<column caption='Util first month' datatype='date' name='[Util first month]' role='dimension' type='ordinal'>
  <calculation class='tableau' formula='{FIXED : MIN([statement_month])}' />
</column>
<column caption='High util rate last' datatype='real' default-format='p0.00%' name='[High util rate last]' role='measure' type='quantitative'>
  <calculation class='tableau' formula='SUM(IF [statement_month] = [Util last month] AND [high_util] THEN [dpd30_rate] END)' />
</column>
<column caption='High util rate first' datatype='real' default-format='p0.00%' name='[High util rate first]' role='measure' type='quantitative'>
  <calculation class='tableau' formula='SUM(IF [statement_month] = [Util first month] AND [high_util] THEN [dpd30_rate] END)' />
</column>
<column-instance column='[high_util]' derivation='None' name='[none:high_util:nk]' pivot='key' type='nominal' />
<column-instance column='[dpd30_rate]' derivation='Sum' name='[sum:dpd30_rate:qk]' pivot='key' type='quantitative' />
<column-instance column='[statement_month]' derivation='Month-Trunc' name='[tmn:statement_month:qk]' pivot='key' type='quantitative' />
</datasource-dependencies>



<aggregation value='true' />
</view>
<style>
<style-rule element='axis'>
<format attr='title' class='0' field='[federated.1bx3v15186r6em0zp6g141tyrfzk].[tmn:statement_month:qk]' scope='cols' value='' />
<format attr='subtitle' class='0' field='[federated.1bx3v15186r6em0zp6g141tyrfzk].[tmn:statement_month:qk]' scope='cols' value='' />
<format attr='title' class='0' field='[federated.1bx3v15186r6em0zp6g141tyrfzk].[sum:dpd30_rate:qk]' scope='rows' value='' />
<format attr='subtitle' class='0' field='[federated.1bx3v15186r6em0zp6g141tyrfzk].[sum:dpd30_rate:qk]' scope='rows' value='' />
</style-rule>
<style-rule element='label'>
