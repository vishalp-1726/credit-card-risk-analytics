<worksheet name='T1 Change by book part'>
<layout-options>
<title>
<formatted-text>
<run bold='true' fontcolor='#515151' fontname='Tableau Semibold' fontsize='10'>Change in 30+ accounts by book part, Aug-2025 → Aug-2026 (</run>
<run bold='true' fontcolor='#b85c00' fontname='Tableau Semibold' fontsize='10'>co-brand</run>
<run bold='true' fontcolor='#515151' fontname='Tableau Semibold' fontsize='10'>)</run>
</formatted-text>
</title>
<caption>
<formatted-text>
<run>analysis as of Aug-2026</run>
</formatted-text>
</caption>
</layout-options>
<table>
<view>
<datasources>
<datasource caption='q1' name='federated.1ejziek0sababv10xub2i1lasjql' />
</datasources>
<datasource-dependencies datasource='federated.1ejziek0sababv10xub2i1lasjql'>
<column caption='Segment' datatype='string' name='[segment]' role='dimension' type='nominal' />
<column caption='Contribution Pp' datatype='real' name='[contribution_pp]' role='measure' type='quantitative' />
<column caption='Rate Aug25' datatype='real' default-format='p0.00%' name='[rate_aug25]' role='measure' type='quantitative' />
<column caption='Rate Aug26' datatype='real' default-format='p0.00%' name='[rate_aug26]' role='measure' type='quantitative' />
<column caption='Share Aug25' datatype='real' name='[share_aug25]' role='measure' type='quantitative' />
<column caption='Share Aug26' datatype='real' name='[share_aug26]' role='measure' type='quantitative' />
<column caption='Dpd30 Accounts Aug25' datatype='integer' name='[dpd30_accounts_aug25]' role='measure' type='quantitative' />
<column caption='Dpd30 Accounts Aug26' datatype='integer' name='[dpd30_accounts_aug26]' role='measure' type='quantitative' />
<column caption='Change' datatype='integer' default-format='n+#,##0;-#,##0' name='[Change]' role='measure' type='quantitative'>
  <calculation class='tableau' formula='SUM([dpd30_accounts_aug26]) - SUM([dpd30_accounts_aug25])' />
</column>
<column caption='Is co-brand' datatype='boolean' name='[Is co-brand]' role='dimension' type='nominal'>
  <calculation class='tableau' formula='CONTAINS([segment], &quot;Co-brand&quot;)' />
</column>
<column caption='Book part' datatype='string' name='[Book part]' role='dimension' type='nominal'>
  <calculation class='tableau' formula='[segment]' />
</column>
<column caption='Aug-2025 to Aug-2026' datatype='string' name='[Aug-2025 to Aug-2026]' role='dimension' type='nominal'>
  <calculation class='tableau' formula='STR(INT(ROUND([rate_aug25] * 10000, 0) / 100)) + &quot;.&quot; + RIGHT(&quot;0&quot; + STR(INT(ROUND([rate_aug25] * 10000, 0)) % 100), 2) + &quot;%&quot; + &quot; → &quot; + STR(INT(ROUND([rate_aug26] * 10000, 0) / 100)) + &quot;.&quot; + RIGHT(&quot;0&quot; + STR(INT(ROUND([rate_aug26] * 10000, 0)) % 100), 2) + &quot;%&quot;' />
</column>
<column-instance column='[Book part]' derivation='None' name='[none:Book part:nk]' pivot='key' type='nominal' />
<column-instance column='[Is co-brand]' derivation='None' name='[none:Is co-brand:nk]' pivot='key' type='nominal' />
<column-instance column='[segment]' derivation='None' name='[none:segment:nk]' pivot='key' type='nominal' />
<column-instance column='[Change]' derivation='User' name='[usr:Change:qk]' pivot='key' type='quantitative' />
</datasource-dependencies>
<filter class='categorical' column='[federated.1ejziek0sababv10xub2i1lasjql].[none:Book part:nk]' filter-group='14'>
<groupfilter function='level-members' level='[none:Book part:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
</filter>
<sort class='computed' column='[federated.1ejziek0sababv10xub2i1lasjql].[none:segment:nk]' direction='DESC' using='[federated.1ejziek0sababv10xub2i1lasjql].[usr:Change:qk]' />
<slices>
<column>[federated.1ejziek0sababv10xub2i1lasjql].[none:Book part:nk]</column>
</slices>
<aggregation value='true' />
</view>
<style>
<style-rule element='axis'>
<format attr='title' class='0' field='[federated.1ejziek0sababv10xub2i1lasjql].[usr:Change:qk]' scope='cols' value='' />
