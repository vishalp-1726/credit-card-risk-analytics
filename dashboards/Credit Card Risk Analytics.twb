<text column='[federated.05tql2e06k415j11ldlo40bdpls6].[usr:Bad A selected:qk]' />
</encodings>

<customized-label>
<formatted-text>
<run bold='true' fontcolor='#1a2142' fontsize='9'>Bad rate at the same approvals</run>
<run>Æ&#10;</run>
<run bold='true' fontcolor='#006de3' fontsize='20'><![CDATA[<[federated.05tql2e06k415j11ldlo40bdpls6].[usr:Bad B selected:qk]>]]></run>
<run bold='true' fontcolor='#006de3' fontsize='20'> vs </run>
<run bold='true' fontcolor='#006de3' fontsize='20'><![CDATA[<[federated.05tql2e06k415j11ldlo40bdpls6].[usr:Bad A selected:qk]>]]></run>
<run>Æ&#10;</run>
